# =========================================
# CI Graph — runtime artifacts (DO NOT COMMIT)
# =========================================
# live view state — overwritten every tick
docs/ci/graph/latest.json
# runtime cache (ephemeral, derived data)
docs/ci/graph/cache/**

# =========================================
# CI Graph — history snapshots (TRACKED)
# =========================================
!docs/ci/graph/tick_*.json
